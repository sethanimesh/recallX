# Use a dedicated data directory per local/test deployment.
RECALLX_DB_PATH=/absolute/path/to/RecallX/backend/db.sqlite
RECALLX_DATA_DIR=/absolute/path/to/RecallX/backend/data
RECALLX_REDIS_URL=redis://127.0.0.1:6380/0
RECALLX_WEB_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081
RECALLX_GRADING_PYTHON=/absolute/path/to/RecallX/backend/.venv-grading/bin/python
RECALLX_OPTIMIZER_PYTHON=/absolute/path/to/RecallX/backend/.venv-grading/bin/python
RECALLX_OCR_PYTHON=/absolute/path/to/RecallX/backend/.venv-ocr/bin/python
RECALLX_MLX_PYTHON=/absolute/path/to/RecallX/backend/.venv-mlx/bin/python
RECALLX_OCR_ACCELERATOR=mlx
RECALLX_GRADING_DEVICE=cpu
# Set only after actual held-out evaluation creates an eligible artifact:
# RECALLX_CALIBRATION_PATH=/absolute/path/to/calibration.json
# Set OCR checkpoint directories after the pinned model download/smoke procedure:
# RECALLX_OCR_LAYOUT_DIR=/absolute/path/to/layout-checkpoint
# RECALLX_OCR_MODEL_DIR=/absolute/path/to/paddleocr-vl-checkpoint
# The default owns a loopback MLX service and stops it after each page.
# Use RECALLX_OCR_ACCELERATOR=cpu for full CPU-only compatibility diagnostics.
# Optional externally managed diagnostic service; it must unload between jobs:
# RECALLX_MLX_URL=http://127.0.0.1:8111/v1
